rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function authed() {
      return request.auth != null;
    }

    function userDocExists() {
      return authed() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return userDocExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '')
        : '';
    }

    function isAdmin() {
      return authed() && userRole() == 'admin';
    }

    function ownsUserDoc(userId) {
      return authed() && request.auth.uid == userId;
    }

    /** Caso: lawyerId = uid del abogado; sin lawyerId solo admin (legacy). */
    function canReadCase() {
      return isAdmin() ||
        (resource.data.keys().hasAll(['lawyerId']) && resource.data.lawyerId == request.auth.uid);
    }

    function canCreateCaseAsOwner() {
      return request.resource.data.keys().hasAll(['lawyerId']) &&
        request.resource.data.lawyerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if authed() && (ownsUserDoc(userId) || isAdmin());
      allow create: if authed() && (ownsUserDoc(userId) || isAdmin());
      allow update, delete: if authed() && (ownsUserDoc(userId) || isAdmin());
    }

    match /users/{userId}/credentials/{credId} {
      allow read, write: if authed() && request.auth.uid == userId;
    }

    match /cases/{caseId} {
      allow read: if authed() && canReadCase();
      allow create: if authed() && (isAdmin() || canCreateCaseAsOwner());
      allow update, delete: if authed() && (
        isAdmin() ||
        (
          resource.data.keys().hasAll(['lawyerId']) &&
          request.resource.data.keys().hasAll(['lawyerId']) &&
          resource.data.lawyerId == request.auth.uid &&
          request.resource.data.lawyerId == request.auth.uid
        )
      );
    }

    match /verificationTokens/{tokenId} {
      allow read, write: if false;
    }
  }
}
